# Compiled binary (build with `go build -o matterbox .` or run via `go run .`)
/matterbox

# Cross-compiled deploy artifacts (e.g. dist/matterbox-linux-amd64)
/dist/

# Go test binaries (`go test -c`)
*.test

# pprof profiles (`go test -cpuprofile=… -memprofile=…`)
*.cpu
*.mem
*.prof
*.pprof
*.heap
*.goroutine

# Local filestore written by the server/ PoC when run locally
# (Mattermost's default FileSettings.Directory layout: data/files/<id>/…)
/data/

# Local project notes, not part of the release
/PLAN.md

# Python bytecode cache
__pycache__/
