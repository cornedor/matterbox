# Compiled binary (build with `go build -o matterbox .` or run via `go run .`)
/matterbox

# Cross-compiled deploy artifacts (e.g. dist/matterbox-linux-amd64)
/dist/

# Go test binaries (`go test -c`)
*.test

# pprof profiles (`go test -cpuprofile=… -memprofile=…`)
*.cpu
*.mem
*.prof
*.pprof
*.heap
*.goroutine

# Local filestore written by the server/ PoC when run locally
# (Mattermost's default FileSettings.Directory layout: data/files/<id>/…)
/data/

# Local project notes, not part of the release
/PLAN.md

# Retrieval/agent eval harnesses (`go test -tags eval`). These are pinned to one
# person's real message cache — they name actual post ids, usernames, and client
# and vendor names — so they stay on the machine that has that data rather than
# in the repo. Rebuild them against your own cache if you need to measure a
# ranking, model, or prompt change.
/internal/store/modeeval_test.go
/internal/store/dimeval_test.go
/internal/store/embedcompare_test.go
/internal/store/vacationeval_test.go
/internal/aisearch/agenteval_test.go

# Python bytecode cache
__pycache__/
