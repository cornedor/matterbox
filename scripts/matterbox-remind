#!/usr/bin/env python3
"""matterbox-remind — scheduled reminders for `matterbox listen`, driven by a rule.

This is an external helper that a `matterbox listen` *exec rule* calls when you
post a `!remind` command in Mattermost. The rules engine only reacts to incoming
messages, so the "fire it later" half lives here, in a tiny SQLite table plus a
once-a-minute systemd timer. Two entry points:

  • As the exec-rule command (no flags): it reads the MATTERBOX_* variables the
    `exec` action exports (and falls back to the JSON envelope on stdin) and acts
    on the message body:

        !remind me in <duration> <text>      schedule for a relative delay
        !remind me at <date> [time] <text>   schedule for a clock date/time
        !reminders   (or  !remind list)      list this channel's pending reminders
        !remind cancel <id>                  cancel one

    <duration> is flexible — weeks/days/hours/minutes/seconds, spelled out or
    abbreviated and combinable: "2 hours", "2 days", "30m", "1h30m",
    "1 day 6 hours", "90 minutes", "2 weeks". A leading "in "/"after " and a
    connector ("… to call dad", "… that the build is done") are ignored.

    <date> [time] (after "at"/"on") is an absolute moment: "2026-07-01",
    "1 July", "jul 1", "03/07" (day-first), a weekday ("friday"), or
    "today"/"tomorrow", each optionally followed by a time ("14:30", "2:30pm",
    "9am", "14h30", "noon"). A date with no time defaults to 09:00; a bare time
    means today. A spec that has already passed but omits the year/date (a
    weekday, a bare time, a no-year date) rolls forward to its next occurrence;
    a fully-specified past moment is rejected.

  • As `matterbox-remind --tick`: deliver every reminder that is now due. Run it
    once a minute from a systemd --user timer (scripts/matterbox-remind.timer).

Reminders live in ~/.config/matterbox/reminders.db (SQLite), so they survive a
daemon — or host — restart; the timer re-scans the table every tick. All posting
back to Mattermost goes through `matterbox reply <post_id>`, so the confirmation,
the listing, and the delivered reminder all thread under the original message. No
Mattermost credentials are handled here — the matterbox CLI holds the saved token.
"""

from __future__ import annotations

import json
import os
import re
import sqlite3
import subprocess
import sys
import time
from datetime import date, datetime, timedelta
from datetime import time as dtime

# --- configuration ---------------------------------------------------------

HOME = os.path.expanduser("~")
CONFIG_DIR = os.environ.get(
    "MATTERBOX_CONFIG_DIR", os.path.join(HOME, ".config", "matterbox")
)
DB_PATH = os.environ.get(
    "MATTERBOX_REMINDERS_DB", os.path.join(CONFIG_DIR, "reminders.db")
)


def _matterbox_bin() -> str:
    """The matterbox CLI to post replies with. systemd --user has a minimal PATH,
    so prefer an absolute path; honour an explicit override."""
    override = os.environ.get("MATTERBOX_BIN")
    if override:
        return override
    local = os.path.join(HOME, ".local", "bin", "matterbox")
    return local if os.path.exists(local) else "matterbox"


MATTERBOX_BIN = _matterbox_bin()

# Stop retrying a reminder whose delivery keeps failing (e.g. its original
# message was deleted) after this many ticks, so a 1-minute timer doesn't retry
# forever. At one tick a minute that is ~1 hour of transient-failure tolerance.
MAX_DELIVER_ATTEMPTS = 60

USAGE = (
    "⏰ Usage:\n"
    "• `!remind me in <when> <message>` — relative, e.g. "
    "`in 2 hours buy milk`, `in 1h30m ping the team`, `in 2 days standup`.\n"
    "• `!remind me at <date> [time] <message>` — clock time, e.g. "
    "`at 2026-07-01 buy milk`, `at tomorrow 9am standup`, "
    "`at friday 17:00 deploy`, `at 03/07 14:30 review`.\n"
    "`!reminders` lists this channel's pending reminders · "
    "`!remind cancel <id>` removes one."
)

# Hour-of-day used when an "at <date>" gives a date but no time.
DEFAULT_HOUR = int(os.environ.get("MATTERBOX_REMIND_HOUR", "9"))


class RemindError(Exception):
    """A request we understood but can't schedule (e.g. a moment in the past).
    Its message is shown to the user."""

# --- duration parsing ------------------------------------------------------

# Seconds per unit, keyed by the unit's first letter. week/day/hour/minute/second
# each start with a distinct letter, so the first letter is an unambiguous key.
_UNIT_SECONDS = {"w": 604800, "d": 86400, "h": 3600, "m": 60, "s": 1}

# One "<number><unit>" token, e.g. "2h", "30 minutes", "1 day". The trailing
# (?![a-z]) keeps "2h30m" splitting into 2h + 30m (a \b would not, since h→3 is
# not a word boundary) while still stopping a bare "m" from eating the "m" in
# "meeting". Leading \s* lets one regex skip the gap between tokens.
_TOKEN = re.compile(
    r"\s*(\d+)\s*"
    r"(weeks?|wks?|w|days?|d|hours?|hrs?|h|minutes?|mins?|m|seconds?|secs?|s)"
    r"(?![a-z])",
    re.IGNORECASE,
)

# A connector word sitting between the duration and the reminder text:
# "in 2h TO call dad", "in 1h THAT the build is done", "in 5m: ship it".
_CONNECTOR = re.compile(r"^(?:(?:to|that|about)\b|[:,\-])\s*", re.IGNORECASE)


def parse_duration(rest: str):
    """Split "<duration> <text>" into (seconds, text).

    Returns (None, rest) when no leading duration is found. A leading "in "/
    "after " is dropped first, and a connector word before the text is stripped.
    """
    rest = re.sub(r"^(?:in|after)\s+", "", rest.strip(), flags=re.IGNORECASE)
    total = 0
    pos = 0
    matched = False
    while True:
        m = _TOKEN.match(rest, pos)
        if m is None:
            break
        total += int(m.group(1)) * _UNIT_SECONDS[m.group(2)[0].lower()]
        pos = m.end()
        matched = True
    if not matched or total <= 0:
        return None, rest
    text = _CONNECTOR.sub("", rest[pos:].strip())
    return total, text.strip()


def humanize(seconds: int) -> str:
    """A compact relative duration: 7200 -> "2h", 9000 -> "2h 30m",
    108000 -> "1d 6h", 45 -> "45s". At most the two largest non-zero units."""
    seconds = max(0, int(seconds))
    if seconds < 60:
        return f"{seconds}s"
    out = []
    for name, size in (("w", 604800), ("d", 86400), ("h", 3600), ("m", 60)):
        if seconds >= size:
            n, seconds = divmod(seconds, size)
            out.append(f"{n}{name}")
        if len(out) == 2:
            break
    return " ".join(out)


# --- absolute date/time parsing ("at <date> [time]") -----------------------

# month/weekday names keyed by their first three letters, which are unambiguous
# (january..december, monday..sunday all differ in the first three).
_MONTHS = {
    "jan": 1, "feb": 2, "mar": 3, "apr": 4, "may": 5, "jun": 6,
    "jul": 7, "aug": 8, "sep": 9, "oct": 10, "nov": 11, "dec": 12,
}
_WEEKDAYS = {
    "mon": 0, "tue": 1, "wed": 2, "thu": 3, "fri": 4, "sat": 5, "sun": 6,
}

# Alternations that match a full or abbreviated month / weekday name; we only
# read the first three letters of whatever matched to look the number up.
_MONTH_RE = (
    r"jan(?:uary)?|feb(?:ruary)?|mar(?:ch)?|apr(?:il)?|may|jun(?:e)?|jul(?:y)?|"
    r"aug(?:ust)?|sep(?:t(?:ember)?)?|oct(?:ober)?|nov(?:ember)?|dec(?:ember)?"
)
_WD_RE = (
    r"mon(?:day)?|tue(?:s(?:day)?)?|wed(?:nesday)?|thu(?:r(?:s(?:day)?)?)?|"
    r"fri(?:day)?|sat(?:urday)?|sun(?:day)?"
)


def _read_date(s: str, today: date):
    """Read a leading date from s. Returns (date, roll, rest).

    `roll` says how to push a past date into the future when it lacks the
    information to be exact: 'year' (no-year calendar date), 'week' (weekday
    name), or None (year given, or today/tomorrow — exact, never rolled)."""
    m = re.match(r"(?i)^\s*(today|tonight|tomorrow)\b", s)
    if m:
        d = today if m.group(1).lower() != "tomorrow" else today + timedelta(days=1)
        return d, None, s[m.end():]
    m = re.match(r"(?i)^\s*(" + _WD_RE + r")\b", s)
    if m:
        wd = _WEEKDAYS[m.group(1)[:3].lower()]
        return today + timedelta(days=(wd - today.weekday()) % 7), "week", s[m.end():]
    m = re.match(r"(?i)^\s*(\d{4})[-/](\d{1,2})[-/](\d{1,2})\b", s)
    if m:
        y, mo, da = (int(g) for g in m.groups())
        return _mkdate(y, mo, da), None, s[m.end():]
    m = re.match(r"(?i)^\s*(\d{1,2})\s+(" + _MONTH_RE + r")(?:\s+(\d{4}))?\b", s)
    if m:
        da, mo, y = int(m.group(1)), _MONTHS[m.group(2)[:3].lower()], m.group(3)
        return _mkdate(int(y) if y else today.year, mo, da), None if y else "year", s[m.end():]
    m = re.match(r"(?i)^\s*(" + _MONTH_RE + r")\s+(\d{1,2})(?:\s*,?\s*(\d{4}))?\b", s)
    if m:
        mo, da, y = _MONTHS[m.group(1)[:3].lower()], int(m.group(2)), m.group(3)
        return _mkdate(int(y) if y else today.year, mo, da), None if y else "year", s[m.end():]
    m = re.match(r"(?i)^\s*(\d{1,2})[-/](\d{1,2})(?:[-/](\d{2,4}))?\b", s)
    if m:  # day-first: 03/07 = 3 July, 03/07/2026, 03/07/26
        da, mo, y = int(m.group(1)), int(m.group(2)), m.group(3)
        if y:
            yi = int(y)
            return _mkdate(yi + 2000 if yi < 100 else yi, mo, da), None, s[m.end():]
        return _mkdate(today.year, mo, da), "year", s[m.end():]
    return None, None, s


def _mkdate(y: int, mo: int, da: int) -> date:
    try:
        return date(y, mo, da)
    except ValueError:
        raise RemindError("that date doesn't exist.")


def _to24(h: int, ap: str) -> int:
    """Convert a 12-hour clock hour + 'a'/'p' into a 24-hour hour."""
    ap = ap.lower()
    if ap == "a":
        return 0 if h == 12 else h
    return 12 if h == 12 else h + 12


def _read_time(s: str):
    """Read a leading time from s. Returns ((hour, minute), rest) or (None, s)."""
    m = re.match(r"(?i)^\s*(\d{1,2}):(\d{2})\s*([ap])\.?m\.?\b", s)
    if m:
        return (_to24(int(m.group(1)), m.group(3)), int(m.group(2))), s[m.end():]
    m = re.match(r"(?i)^\s*(\d{1,2}):(\d{2})\b", s)
    if m:
        return (int(m.group(1)), int(m.group(2))), s[m.end():]
    m = re.match(r"(?i)^\s*(\d{1,2})\s*([ap])\.?m\.?\b", s)
    if m:
        return (_to24(int(m.group(1)), m.group(2)), 0), s[m.end():]
    m = re.match(r"(?i)^\s*(\d{1,2})h(\d{2})?(?![a-z0-9])", s)
    if m:
        return (int(m.group(1)), int(m.group(2) or 0)), s[m.end():]
    m = re.match(r"(?i)^\s*noon\b", s)
    if m:
        return (12, 0), s[m.end():]
    m = re.match(r"(?i)^\s*midnight\b", s)
    if m:
        return (0, 0), s[m.end():]
    return None, s


def parse_at(rest: str, now: int):
    """Parse "<date> [time] <text>" into (due_epoch, text).

    Returns (None, rest) when no date or time is found. Raises RemindError for a
    moment we recognise but can't schedule (already past, or an impossible
    date/time)."""
    today = datetime.fromtimestamp(now).astimezone().date()
    date_obj, roll, after = _read_date(rest.strip(), today)
    rem = after if date_obj is not None else rest.strip()
    # allow a connecting "at"/"@" before the time, e.g. "tomorrow at 3pm".
    rem = re.sub(r"(?i)^\s*(?:at|@)\s+", " ", rem)
    tm, after_time = _read_time(rem)
    if date_obj is None and tm is None:
        return None, rest
    if tm is not None:
        rem = after_time
    if date_obj is None:  # a bare time means today, rolling to tomorrow if past.
        date_obj, roll = today, "day"
    hh, mm = tm if tm is not None else (DEFAULT_HOUR, 0)
    if hh > 23 or mm > 59:
        raise RemindError("that's not a valid time of day.")
    target = datetime.combine(date_obj, dtime(hh, mm)).astimezone()
    if target.timestamp() <= now:
        if roll == "year":
            try:
                target = target.replace(year=target.year + 1)
            except ValueError:  # 29 Feb -> non-leap year
                target += timedelta(days=365)
        elif roll == "week":
            target += timedelta(days=7)
        elif roll == "day":
            target += timedelta(days=1)
        else:
            raise RemindError(f"that's in the past ({target:%a %d %b %H:%M}).")
    text = _CONNECTOR.sub("", rem.strip()).strip()
    return int(target.timestamp()), text


def compute_due(rest: str, now: int):
    """Resolve a reminder spec to (due_epoch, text). "at"/"on"/"@" forces an
    absolute date/time; otherwise a relative duration is tried first, then a
    bare absolute date as a fallback. Returns (None, rest) if nothing parses."""
    m = re.match(r"(?i)^(?:at|on|@)\b\s*", rest)
    if m:
        due, text = parse_at(rest[m.end():], now)
        if due is None:
            raise RemindError("I couldn't read a date or time after that.")
        return due, text
    seconds, text = parse_duration(rest)
    if seconds is not None:
        return now + seconds, text
    return parse_at(rest, now)  # e.g. "!remind me tomorrow 9am …" (no keyword)


# --- storage ---------------------------------------------------------------


def db() -> sqlite3.Connection:
    os.makedirs(CONFIG_DIR, exist_ok=True)
    con = sqlite3.connect(DB_PATH, timeout=10)
    con.execute("PRAGMA journal_mode=WAL")
    con.execute(
        """
        CREATE TABLE IF NOT EXISTS reminders (
            id         INTEGER PRIMARY KEY AUTOINCREMENT,
            channel_id TEXT    NOT NULL,
            post_id    TEXT    NOT NULL,   -- the !remind message, for threading
            author     TEXT    NOT NULL,
            text       TEXT    NOT NULL,
            due_at     INTEGER NOT NULL,   -- unix seconds
            created_at INTEGER NOT NULL,
            delivered  INTEGER NOT NULL DEFAULT 0,  -- 0 pending, 1 sent, 2 gave up
            attempts   INTEGER NOT NULL DEFAULT 0
        )
        """
    )
    con.execute(
        "CREATE INDEX IF NOT EXISTS reminders_pending ON reminders(delivered, due_at)"
    )
    return con


# --- posting back ----------------------------------------------------------


def reply(post_id: str, text: str) -> bool:
    """Post text as a threaded reply under post_id via the matterbox CLI."""
    if not post_id:
        sys.stderr.write("matterbox-remind: no post id to reply to\n")
        return False
    try:
        r = subprocess.run(
            [MATTERBOX_BIN, "reply", post_id, text],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=25,
        )
    except (subprocess.TimeoutExpired, OSError) as e:
        sys.stderr.write(f"matterbox-remind: reply failed: {e}\n")
        return False
    if r.returncode != 0:
        out = r.stdout.decode(errors="replace").strip()
        sys.stderr.write(f"matterbox-remind: reply exit {r.returncode}: {out}\n")
        return False
    return True


# --- commands (exec-rule entry point) --------------------------------------


def cmd_set(channel_id: str, post_id: str, author: str, rest: str) -> None:
    rest = rest.strip()
    if not rest:
        reply(post_id, USAGE)
        return
    now = int(time.time())
    try:
        due, text = compute_due(rest, now)
    except RemindError as e:
        reply(post_id, f"⏰ {e}\n" + USAGE)
        return
    if due is None:
        reply(post_id, "⏰ I couldn't read a time in that.\n" + USAGE)
        return
    seconds = due - now
    text = text.strip() or "(reminder)"
    con = db()
    with con:
        cur = con.execute(
            "INSERT INTO reminders(channel_id, post_id, author, text, due_at, created_at)"
            " VALUES(?, ?, ?, ?, ?, ?)",
            (channel_id, post_id, author, text, due, now),
        )
        rid = cur.lastrowid
    con.close()
    when = datetime.fromtimestamp(due).astimezone()
    reply(
        post_id,
        f"⏰ Reminder #{rid} set for {when:%a %d %b %H:%M} "
        f"(in {humanize(seconds)}) — {text}",
    )


def cmd_list(channel_id: str, post_id: str) -> None:
    con = db()
    rows = con.execute(
        "SELECT id, text, due_at FROM reminders"
        " WHERE channel_id = ? AND delivered = 0 ORDER BY due_at",
        (channel_id,),
    ).fetchall()
    con.close()
    if not rows:
        reply(post_id, "📋 No pending reminders in this channel.")
        return
    now = int(time.time())
    lines = [f"📋 {len(rows)} pending reminder(s) in this channel:"]
    for rid, text, due in rows:
        when = datetime.fromtimestamp(due).astimezone()
        lines.append(
            f"  • #{rid} — {when:%a %d %b %H:%M} (in {humanize(due - now)}) — {text}"
        )
    lines.append("_cancel with_ `!remind cancel <id>`")
    reply(post_id, "\n".join(lines))


def cmd_cancel(channel_id: str, post_id: str, rid: int) -> None:
    con = db()
    with con:
        # Only a pending reminder in THIS channel, so a stray id from elsewhere
        # can't be removed by mistake.
        cur = con.execute(
            "DELETE FROM reminders WHERE id = ? AND channel_id = ? AND delivered = 0",
            (rid, channel_id),
        )
        n = cur.rowcount
    con.close()
    if n:
        reply(post_id, f"🗑️ Reminder #{rid} cancelled.")
    else:
        reply(post_id, f"⏰ No pending reminder #{rid} in this channel.")


def handle_message() -> None:
    """Dispatch a !remind command from the exec-rule environment."""
    msg = os.environ.get("MATTERBOX_MESSAGE", "")
    channel_id = os.environ.get("MATTERBOX_CHANNEL_ID", "")
    post_id = os.environ.get("MATTERBOX_POST_ID", "")
    author = os.environ.get("MATTERBOX_AUTHOR", "")
    # Fall back to the stdin JSON envelope (e.g. a manual test piping the
    # payload instead of exporting the env vars).
    if not msg and not sys.stdin.isatty():
        try:
            env = json.load(sys.stdin)
            msg = env.get("message", "")
            channel_id = channel_id or env.get("channel_id", "")
            post_id = post_id or env.get("post_id", "")
            author = author or env.get("author", "")
        except (json.JSONDecodeError, ValueError):
            pass

    text = msg.strip()
    # list:  !reminders   |   !remind[er] list/ls
    if re.match(r"(?i)^!reminders\b", text) or re.match(
        r"(?i)^!remind(?:er)?\s+(?:list|ls)\b", text
    ):
        cmd_list(channel_id, post_id)
        return
    # cancel:  !remind[er] cancel|rm|del|delete|forget <id>
    m = re.match(
        r"(?i)^!remind(?:er)?\s+(?:cancel|rm|del|delete|forget)\s+#?(\d+)", text
    )
    if m:
        cmd_cancel(channel_id, post_id, int(m.group(1)))
        return
    # set:  !remind[er] [me] <duration> <text>
    m = re.match(r"(?i)^!remind(?:er)?\s*(.*)$", text, re.DOTALL)
    rest = m.group(1) if m else ""
    rest = re.sub(r"(?i)^(?:me|myself)\b\s*", "", rest.strip())
    cmd_set(channel_id, post_id, author, rest)


# --- delivery (timer entry point) ------------------------------------------


def tick() -> None:
    """Deliver every reminder that is now due. Idempotent and safe to run often."""
    con = db()
    now = int(time.time())
    rows = con.execute(
        "SELECT id, post_id, text FROM reminders"
        " WHERE delivered = 0 AND due_at <= ? AND attempts < ? ORDER BY due_at",
        (now, MAX_DELIVER_ATTEMPTS),
    ).fetchall()
    for rid, post_id, text in rows:
        ok = reply(post_id, f"⏰ Reminder: {text}")
        with con:
            if ok:
                con.execute("UPDATE reminders SET delivered = 1 WHERE id = ?", (rid,))
            else:
                # Count the failed attempt; give up permanently at the cap so a
                # deleted trigger message can't make us retry forever.
                con.execute(
                    "UPDATE reminders SET attempts = attempts + 1,"
                    " delivered = CASE WHEN attempts + 1 >= ? THEN 2 ELSE 0 END"
                    " WHERE id = ?",
                    (MAX_DELIVER_ATTEMPTS, rid),
                )
    con.close()


# --- self-test (no network) ------------------------------------------------


def selftest() -> None:
    cases = {
        "in 2 hours buy milk": (7200, "buy milk"),
        "2 hours buy milk": (7200, "buy milk"),
        "2h30m do the thing": (9000, "do the thing"),
        "1 day 6 hours meeting prep": (108000, "meeting prep"),
        "30m": (1800, ""),
        "90 minutes water the plants": (5400, "water the plants"),
        "2 days": (172800, ""),
        "1 week standup": (604800, "standup"),
        "in 15 min to call dad": (900, "call dad"),
        "5m: ship it": (300, "ship it"),
        "2h tomatoes for dinner": (7200, "tomatoes for dinner"),
        "1h30m ping the team": (5400, "ping the team"),
        "tomorrow": (None, "tomorrow"),
        "buy milk": (None, "buy milk"),
    }
    ok = True
    for inp, want in cases.items():
        got = parse_duration(inp)
        status = "ok " if got == want else "FAIL"
        if got != want:
            ok = False
        print(f"[{status}] parse {inp!r} -> {got!r}" + ("" if got == want else f"  want {want!r}"))
    for sec, want in [
        (7200, "2h"),
        (9000, "2h 30m"),
        (108000, "1d 6h"),
        (1800, "30m"),
        (45, "45s"),
        (604800, "1w"),
    ]:
        got = humanize(sec)
        status = "ok " if got == want else "FAIL"
        if got != want:
            ok = False
        print(f"[{status}] humanize({sec}) -> {got!r}" + ("" if got == want else f"  want {want!r}"))

    # Absolute "at <date> [time]" parsing. Pin the timezone so the expected
    # epochs are reproducible regardless of where the test runs.
    os.environ["TZ"] = "Europe/Amsterdam"
    time.tzset()
    now = int(datetime(2026, 7, 1, 12, 0, 0).timestamp())  # Wed 1 Jul 2026, 12:00

    def due(y, mo, da, h=9, mi=0):
        return int(datetime(y, mo, da, h, mi).timestamp())

    at_cases = [
        ("2026-07-02 buy milk", (due(2026, 7, 2), "buy milk")),       # date only -> 09:00
        ("2026-07-02 14:30 buy milk", (due(2026, 7, 2, 14, 30), "buy milk")),
        ("tomorrow 9am standup", (due(2026, 7, 2, 9, 0), "standup")),
        ("tomorrow water plants", (due(2026, 7, 2), "water plants")),
        ("today 18:00 dinner", (due(2026, 7, 1, 18, 0), "dinner")),
        ("15:00 call dad", (due(2026, 7, 1, 15, 0), "call dad")),     # today, still ahead
        ("9am ship it", (due(2026, 7, 2, 9, 0), "ship it")),         # past today -> tomorrow
        ("friday 17:00 deploy", (due(2026, 7, 3, 17, 0), "deploy")),  # Wed -> Fri
        ("3 jul standup", (due(2026, 7, 3), "standup")),
        ("jul 3 standup", (due(2026, 7, 3), "standup")),
        ("3 jun reminder", (due(2027, 6, 3), "reminder")),           # passed -> next year
        ("03/07 review", (due(2026, 7, 3), "review")),               # day-first dd/mm
        ("2pm to call dad", (due(2026, 7, 1, 14, 0), "call dad")),   # connector stripped
        ("tomorrow at 14h30 gym", (due(2026, 7, 2, 14, 30), "gym")),
        ("noon lunch", (due(2026, 7, 2, 12, 0), "lunch")),           # 12:00 == now -> tomorrow
        ("buy milk", (None, "buy milk")),                            # no date/time
    ]
    for inp, want in at_cases:
        got = parse_at(inp, now)
        status = "ok " if got == want else "FAIL"
        if got != want:
            ok = False
        print(f"[{status}] parse_at {inp!r} -> {got!r}" + ("" if got == want else f"  want {want!r}"))

    for inp in ("2020-01-01 09:00 past", "today 06:00 too early"):
        try:
            parse_at(inp, now)
            ok = False
            print(f"[FAIL] parse_at {inp!r} -> no error  want RemindError(past)")
        except RemindError:
            print(f"[ok ] parse_at {inp!r} -> RemindError (past)")

    sys.exit(0 if ok else 1)


def main() -> None:
    args = sys.argv[1:]
    if args and args[0] in ("--tick", "tick"):
        tick()
    elif args and args[0] in ("--selftest", "selftest"):
        selftest()
    else:
        handle_message()


if __name__ == "__main__":
    main()
