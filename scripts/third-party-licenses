#!/bin/sh
# Collect the license texts of every Go module linked into the matterbox binary
# and print them as one THIRD_PARTY_LICENSES file on stdout.
#
# Why this exists: matterbox itself is Apache-2.0 (see LICENSE), but a compiled
# binary statically links ~90 third-party modules, and the MIT/BSD/ISC/Apache
# licenses they carry all require their notices to travel with a *binary*
# distribution. The source repo has no such duty (it vendors nothing), so this
# file is generated at release time and dropped into the tarball next to the
# binary rather than checked in — that way it can never drift from go.mod.
#
#   scripts/third-party-licenses > THIRD_PARTY_LICENSES
#   TAGS=demoaudio,video scripts/third-party-licenses   # match a tagged build
#
# The module set follows the build being described, so GOOS/GOARCH/TAGS matter:
# a linux binary links x/sys/unix and charmbracelet/x/termios, a darwin one
# doesn't. Run it with the same environment as the `go build` it accompanies.
# Test-only dependencies (testify, go-spew, …) are excluded — they aren't in the
# binary. Output is sorted by module path and carries no timestamps, so the same
# inputs always produce a byte-identical file.
#
# It also fails the build if a GPL/AGPL module has crept into the link, because
# such a binary cannot be distributed under Apache-2.0. Today that catches
# exactly one thing: `-tags demoaudio` pulls in github.com/gotracker/opl2 (a
# GPL-2.0-or-later port of DOSBox's dbopl) through gotracker/playback's core
# packages, so a demoaudio binary is only conveyable under GPLv3. The release
# workflow builds tag-free and stays clean. Set ALLOW_COPYLEFT=1 to generate
# the file anyway for a local build you are not going to hand to anyone.

set -eu

GO=${GO:-go}
TAGS=${TAGS:-}
ALLOW_COPYLEFT=${ALLOW_COPYLEFT:-0}
tagflag=""
[ -n "$TAGS" ] && tagflag="-tags=$TAGS"

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT INT TERM

# Every module reachable from the main package, i.e. everything the linker sees.
# .Module.Dir points straight at the module root in the module cache, which
# saves us re-implementing the cache's !uppercase path escaping by hand.
"$GO" list -deps $tagflag -f '{{with .Module}}{{.Path}}|{{.Version}}|{{.Dir}}{{end}}' . |
	grep -v '^$' | grep -v '^matterbox|' | sort -u -t'|' -k1,1 > "$work/mods"

[ -s "$work/mods" ] || { echo "third-party-licenses: go list returned no modules" >&2; exit 1; }

cat <<'EOF'
                        THIRD-PARTY SOFTWARE NOTICES

matterbox is licensed under the Apache License, Version 2.0 — see the LICENSE
and NOTICE files distributed alongside this one.

The matterbox binary is statically linked, so it contains code from the
third-party Go modules listed below. Each module remains under its own license,
reproduced in full here, and each copyright holder retains their rights. This
file is provided to satisfy the notice-retention requirements of those licenses
(among them Apache-2.0 sections 4(a) and 4(d), and the MIT/BSD/ISC clauses
requiring the copyright notice and permission text to accompany binary
redistributions).

Mozilla Public License 2.0 — written offer of source code
---------------------------------------------------------
Some of the modules below are covered by the Mozilla Public License 2.0. As
required by MPL-2.0 section 3.2, the complete corresponding source code of
those modules is available at no charge from the Go module proxy, which serves
the exact versions linked into this binary:

    https://proxy.golang.org/<module-path>/@v/<version>.zip

for example, using the module path and version printed in each section below.
The same versions can be fetched with `go mod download <module-path>@<version>`
or retrieved from each project's upstream repository.

EOF

# Read from a file rather than a pipe: a `while read` on the right-hand side of
# a pipe runs in a subshell, so the copyleft tally below (and any exit) would be
# thrown away with it.
while IFS='|' read -r path version dir; do
	[ -d "$dir" ] || {
		echo "third-party-licenses: no module dir for $path@$version (run 'go mod download')" >&2
		exit 1
	}

	# License and notice files live at the module root in almost every module,
	# but a few (golang.org/x/*, grpc) also carry PATENTS or a NOTICE.txt, and
	# some monorepo submodules keep theirs one level up in the extracted zip.
	find "$dir" -maxdepth 2 \
		\( -iname 'LICENSE' -o -iname 'LICENSE.*' -o -iname 'LICENCE' \
		-o -iname 'LICENCE.*' -o -iname 'COPYING' -o -iname 'COPYING.*' \
		-o -iname 'NOTICE' -o -iname 'NOTICE.*' -o -iname 'PATENTS' \) \
		-type f 2>/dev/null | sort > "$work/files"

	if [ ! -s "$work/files" ]; then
		echo "third-party-licenses: $path@$version ships no license file" >&2
		exit 1
	fi

	# Classify from the licence title in the first few lines, not a full-text
	# grep: the MPL-2.0 text names the GPL/LGPL/AGPL in its "Secondary License"
	# definition, so grepping whole files would flag every hashicorp module.
	primary=$(head -1 "$work/files")
	if head -8 "$primary" | grep -qiE 'GNU (AFFERO )?GENERAL PUBLIC LICENSE' &&
		! head -8 "$primary" | grep -qi 'LESSER'; then
		echo "$path@$version" >> "$work/copyleft"
	fi

	echo "================================================================================"
	echo "$path"
	echo "  version: $version"
	echo "================================================================================"
	echo

	while IFS= read -r f; do
		# Label each text by filename so a NOTICE isn't mistaken for the license
		# itself (Apache 4(d) notices must be reproduced, but they are not grants).
		echo "--- $(basename "$f") ---"
		echo
		cat "$f"
		echo
	done < "$work/files"
done < "$work/mods"

echo "third-party-licenses: $(wc -l < "$work/mods" | tr -d ' ') modules${TAGS:+ (tags: $TAGS)}" >&2

# The module scan above cannot see the `video` tag's real dependency. go-astiav
# is MIT, but it is only cgo bindings — the code that ends up in the binary is
# the system's ffmpeg, whose licence depends on how that ffmpeg was configured
# (LGPL by default, GPL with --enable-gpl, unredistributable with
# --enable-nonfree). So ask the linked library itself; see internal/libav.
case ",$(printf '%s' "$TAGS" | tr ' ' ',')," in
*,video,*)
	if ! "$GO" run -tags "$TAGS" ./internal/libav/probe > "$work/libav" 2>"$work/libaverr"; then
		echo >&2
		echo "third-party-licenses: could not determine the linked ffmpeg's licence:" >&2
		sed 's/^/    /' "$work/libaverr" >&2
		echo "  Refusing to vouch for a build whose ffmpeg licence is unknown." >&2
		exit 1
	fi
	# Read the fields rather than sourcing them: the licence string contains
	# spaces, so `. "$work/libav"` would run "version" and "3" as commands.
	field() { sed -n "s/^$1=//p" "$work/libav"; }
	av_version=$(field version)
	av_license=$(field license)
	av_class=$(field class)
	av_ok=$(field distributable)

	echo "third-party-licenses: ffmpeg $av_version, $av_license (class: $av_class)" >&2

	if [ "$av_ok" != "1" ]; then
		echo >&2
		echo "third-party-licenses: this build links ffmpeg under \"$av_license\"." >&2
		echo "  A binary containing it cannot be distributed under Apache-2.0." >&2
		echo "  Build against an LGPL ffmpeg (configured without --enable-gpl)," >&2
		echo "  drop -tags video, or do not distribute this binary." >&2
		if [ "$ALLOW_COPYLEFT" != "1" ]; then
			echo "  (set ALLOW_COPYLEFT=1 to generate anyway for local use)" >&2
			exit 1
		fi
	fi

	# An LGPL ffmpeg may ship with an Apache-2.0 binary, but not silently: LGPL
	# 2.1 section 4 wants the library named, its licence text available, and its
	# source obtainable. Emit that section so a video build's bundle is complete
	# rather than merely un-refused.
	echo "================================================================================"
	echo "FFmpeg (libav*) — linked C libraries, not a Go module"
	echo "  version: $av_version"
	echo "================================================================================"
	echo
	echo "This binary was built with -tags video, which links the FFmpeg libraries"
	echo "(libavcodec, libavformat, libavutil, libswscale, …) through the MIT-licensed"
	echo "cgo bindings github.com/asticode/go-astiav, whose own licence appears above."
	echo "FFmpeg itself is separate software with its own terms, and the libraries"
	echo "linked here report:"
	echo
	echo "    $av_license"
	echo
	echo "Source code for FFmpeg, including the exact release linked here, is available"
	echo "from https://ffmpeg.org/download.html and https://git.ffmpeg.org/ffmpeg.git ."
	echo "The full licence texts, and FFmpeg's own notes on which configurations produce"
	echo "which licence, are at https://www.ffmpeg.org/legal.html ."
	echo
	# Distros ship the text on disk; include it verbatim when we can find it,
	# since a pointer is weaker than the copy the licence asks for.
	for d in /usr/share/licenses/ffmpeg-libs /usr/share/licenses/ffmpeg \
		/usr/share/doc/libavutil* /usr/share/doc/ffmpeg; do
		[ -d "$d" ] || continue
		# No cap: a distro ships several (GPLv2, GPLv3, LGPLv2.1, LGPLv3) and
		# quietly dropping one would leave the bundle short of a licence text
		# it claims to carry.
		found=$(find "$d" -maxdepth 1 -type f \
			\( -iname 'COPYING*' -o -iname 'LICENSE*' \) 2>/dev/null | sort)
		[ -n "$found" ] || continue
		for f in $found; do
			echo "--- $(basename "$f") (from $d) ---"
			echo
			cat "$f"
			echo
		done
		break
	done
	;;
esac

if [ -f "$work/copyleft" ]; then
	echo >&2
	echo "third-party-licenses: GPL/AGPL module(s) linked into this build:" >&2
	sed 's/^/    /' "$work/copyleft" >&2
	echo >&2
	echo "  A binary containing these cannot be distributed under Apache-2.0." >&2
	echo "  Build without the offending tag, or do not distribute this binary." >&2
	if [ "$ALLOW_COPYLEFT" != "1" ]; then
		echo "  (set ALLOW_COPYLEFT=1 to generate anyway for local use)" >&2
		exit 1
	fi
fi
